<?xml version='1.0' encoding='UTF-8'?>
<addons><addon id="repository.fentastic" name="FENtastic Community Repository" version="1.0.3" provider-name="FENtastic Community">
    <extension point="xbmc.addon.repository" name="FENtastic Community Repository">
        <dir minversion="21.0.0" maxversion="21.9.9">
            <info compressed="false">https://raw.githubusercontent.com/fentastic-org/fentastic-org.github.io/main/files/omega/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/fentastic-org/fentastic-org.github.io/main/files/omega/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/fentastic-org/fentastic-org.github.io/main/files/omega/</datadir>
        </dir>
        <dir minversion="22.0.0">
            <info compressed="false">https://raw.githubusercontent.com/fentastic-org/fentastic-org.github.io/main/files/piers/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/fentastic-org/fentastic-org.github.io/main/files/piers/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/fentastic-org/fentastic-org.github.io/main/files/piers/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>FENtastic Community Repository</summary>
        <description>Community maintained fork of ivarbrandt's FENtastic skin for Kodi.</description>
        <disclaimer />
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon><addon id="script.fentastic.helper" name="FENtastic Helper" version="0.8.3" provider-name="Tikipeter, Ivar Brandt">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
        <import addon="script.module.requests" version="2.19.1" />
    </requires>
    <extension point="xbmc.python.library" library="resources/lib/default.py" />
    <extension point="xbmc.service" library="resources/lib/service.py" start="startup" />
    <extension point="xbmc.addon.metadata">
        <news />
        <platform>all</platform>
        <license>GPL-2.0-only</license>
        <forum />
        <source />
        <description lang="en_GB">FENtastic Helper for the FENtastic Skin.</description>
        <description lang="en_NZ">FENtastic Helper for the FENtastic Skin.</description>
        <description lang="en_US">FENtastic Helper for the FENtastic Skin.</description>
    </extension>
</addon><addon id="skin.fentastic" version="1.5.8" name="Fentastic" provider-name="fentastic-org, Ivar Brandt">
	<requires>
		<import addon="xbmc.gui" version="5.17.0" />
		<import addon="script.fentastic.helper" version="0.8.3" />
	</requires>
	<extension point="xbmc.gui.skin" debugging="false">
		<res width="1920" height="1440" aspect="4:3" default="false" folder="xml" />
		<res width="1920" height="1280" aspect="3:2" default="false" folder="xml" />
		<res width="1920" height="1200" aspect="16:10" default="false" folder="xml" />
		<res width="2040" height="1080" aspect="17:9" default="false" folder="xml" />
		<res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
		<res width="2560" height="1080" aspect="21:9" default="false" folder="xml" />
		<res width="2338" height="1080" aspect="19.5:9" default="false" folder="xml" />
		<res width="2160" height="1080" aspect="18:9" default="false" folder="xml" />
	</extension>
	<extension point="xbmc.addon.metadata">
		<platform>all</platform>
		<license>CC BY-SA 4.0, GNU GENERAL PUBLIC LICENSE Version 2.0</license>
		<forum>http://forum.kodi.tv/</forum>
		<source>https://github.com/fentastic-org/skin.fentastic</source>
		<assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.jpg</fanart>
			<screenshot>resources/images/customizable_widgets.jpg</screenshot>
			<screenshot>resources/images/infopanel.jpg</screenshot>
			<screenshot>resources/images/viewtypes1.jpg</screenshot>
		</assets>
		<summary lang="en_GB">FENtastic skin (Estuary MOD) — community fork by fentastic-org</summary>
		<summary lang="en_NZ">FENtastic skin (Estuary MOD) — community fork by fentastic-org</summary>
		<summary lang="en_US">FENtastic skin (Estuary MOD) — community fork by fentastic-org</summary>
		<description lang="en_GB">FENtastic is a community-maintained fork of Ivar Brandt's FENtastic skin, based on the default Estuary skin for Kodi. Features include custom viewtypes, customizable widgets, advanced HDR/video processing overlays, and more.[CR][CR]See [B]CHANGELOG[/B] located in Skin settings » Extra info for latest changes.</description>
		<description lang="en_NZ">FENtastic is a community-maintained fork of Ivar Brandt's FENtastic skin, based on the default Estuary skin for Kodi. Features include custom viewtypes, customizable widgets, advanced HDR/video processing overlays, and more.[CR][CR]See [B]CHANGELOG[/B] located in Skin settings » Extra info for latest changes.</description>
		<description lang="en_US">FENtastic is a community-maintained fork of Ivar Brandt's FENtastic skin, based on the default Estuary skin for Kodi. Features include custom viewtypes, customizable widgets, advanced HDR/video processing overlays, and more.[CR][CR]See [B]CHANGELOG[/B] located in Skin settings » Extra info for latest changes.</description>
	</extension>
</addon></addons>